+#ifdef ROGUE_LAYERED
+/* Historical C drops an int for zero-argument callbacks. Wasm requires the
+ * actual signature. All registered callbacks are void(void), except turn_see. */
+static void invoke_action(void (*function)(),int argument)
+{
+    if (function == (void(*)())turn_see)
+        (void)turn_see((bool)argument);
+    else if (function == runners || function == doctor || function == stomach ||
+             function == swander || function == rollwand || function == unconfuse ||
+             function == unsee || function == sight || function == nohaste ||
+             function == come_down || function == visuals || function == land)
+        function();
+    else
+        rg_core_abort();
+}
+#endif
